---
const { event } = Astro.props;
---

<a href={`/single-view/${event.id}`}>
  <article>
    <div class="list-card-textwrapper">
      <h2>{event.event_navn}</h2>
      <p>{event.short_info}</p>
    </div>

    <div class="listcard-img-button">
      <img src={event.img} alt={event.event_navn} />
      <span class="read-more">Read more</span>
    </div>
  </article>
</a>

<!-- 
  Udkommenterer denne, da vi ikke ville have et "åbent event" men hellere ville guide brugeren direkte til singleview
  <a href={`/details/${event.id}`}>Læs mere</a> -->

<style>
  a {
    display: block;
    color: #160709;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  a:hover,
  a:focus-visible {
    transform: translateY(-4px) scale(1.01);
  }

  article {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "text image";
    gap: 12px;
    min-height: 240px;
    padding: 12px;
    box-sizing: border-box;
    border-radius: 22px;
    background: rgb(200 232 248 / 80%);
    box-shadow: 0 4px 8px rgb(0 0 0 / 25%);
  }

  .list-card-textwrapper {
    grid-area: text;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* h2 {
      margin: 0;
      line-height: 1;
      text-transform: uppercase;
    } */

  .listcard-img-button {
    grid-area: image;
    position: relative;
    min-height: 190px;
    overflow: hidden;
    border-radius: 10px;
  }

  .listcard-img-button img {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
  }

  .listcard-img-button :global(.read-more) {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
  }

  .read-more {
    background-color: #160709;
    color: #fffff5;
    padding: 10px 20px;
    border-radius: 15px;
    text-decoration: none;
    font-size: 8px;
    cursor: pointer;
    box-sizing: border-box;
  }

  .read-more:hover {
    background-color: #5c5153;
  }

  :global(a:nth-child(even)) article {
    grid-template-areas: "image text";
  }
</style>

---
const { event } = Astro.props;
import Buttonbrun from "../components/Buttonbrun.astro";
---

<a href={`/single-view/${event.id}`}>
  <article>
    <img src={event.img} alt={event.event_navn} />
    <h2>{event.event_navn}</h2>
    <p>{event.short_info}</p>
    <Buttonbrun text="Read more" href={`/single-view/${event.id}`} />
  </article>
</a>

<!-- 
  Udkommenterer denne, da vi ikke ville have et "åbent event" men hellere ville guide brugeren direkte til singleview
  <a href={`/details/${event.id}`}>Læs mere</a> -->

<style>
  a {
    text-decoration: none;
    color: #160709;
  }
  article {
    border-radius: 20px;
    background-color: rgb(200, 232, 248, 0.8);
  }

  img {
    border-radius: 10px;
    width: 120px;
    height: 130px;
  }
</style>

---
import ListCard from '../components/ListCard.astro';
import Layoutevent from '../layouts/Layoutevent.astro';
const endpoint = 'https://xrxrkbvgveqggbyflllj.supabase.co/rest/v1/Event_list?select=*';
const options = {
    headers:{apikey: 'sb_publishable_JC8KpAkpoJ3W0WeRi7EfsA_4lgf8OWs'}
}
const events = await fetch(endpoint, options).then((res)=> res.json());
import Buttonblaa from '../components/Buttonblaa.astro';
---

<Layoutevent title="Events">
 
 <Buttonblaa text="TICKETS" href="/eventlist" />
 
    <h2>UPCOMING EVENTS</h2>
    <section class="hero">
        {events.map((event) => <ListCard {event} />)}
    </section>
</Layoutevent>

<style> 

.hero {
    min-height: 500px;
  background-image: url('/kdlistview.webp');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}</style>
---
const { text, href } = Astro.props;
---

<a href={href} class="buttonblaa">
    {text}
</a>

<style>
	.buttonblaa {
		background-color: #C8E8F8;
		color: #160709;
		padding: 10px 20px;
		border-radius: 15px;
		text-decoration: none;
		display: inline-flex; 
		font-size: 8px;
		cursor: pointer;
box-sizing: border-box;
align-items: center;
justify-content: center;
	}


.buttonblaa:hover {
    background-color: #A0D4E6;
}
</style>
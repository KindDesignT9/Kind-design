---
import ListCard from "../components/ListCard.astro";
import Navbareventside from "../components/Navbareventside.astro";
import Layout from "../layouts/Layout.astro";
import ButtonBack from "../components/ButtonBack.astro";
const endpoint = "https://xrxrkbvgveqggbyflllj.supabase.co/rest/v1/Event_list?select=*";
const options = {
  headers: { apikey: "sb_publishable_JC8KpAkpoJ3W0WeRi7EfsA_4lgf8OWs" },
};
const events = await fetch(endpoint, options).then((res) => res.json());
import Buttonblaa from "../components/Buttonblaa.astro";
---

<Layout>
  <Navbareventside />
  <div class="heroevent">
    <ButtonBack />
    <h1>
      UPCOMING <br /> EVENTS
    </h1>
  </div>

  <div class="hero">
    <div class="filterwrap">
      <Buttonblaa text="All events" href="/eventlist" /> <Buttonblaa text="Talks" href="/eventlist" /> <Buttonblaa text="Workshops" href="/eventlist" /> <Buttonblaa text="Social" href="/eventlist" />
    </div>
    <section>
      {events.map((event) => (
        <ListCard {event} />
      ))}
    </section>
  </div>
</Layout>

<style>
  .heroevent {
    margin: 1rem;
    padding-top: 5rem;
  }
  h1 {
    margin-top: 1rem;
    margin-left: 1.5rem;
  }

  section {
    display: grid;
    padding-bottom: 2rem;
    gap: 2rem;
    margin: 2rem;
  }
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 500px;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url("/kdlistview.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.9;
  }

  .filterwrap {
    padding: 2rem;
  }

  @media (min-width: 768px) {
    section {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    section > :global(a:nth-child(odd)) {
      grid-column: 1 / 3;
    }

    section > :global(a:nth-child(even)) {
      grid-column: 2 / 4;
    }
  }
</style>

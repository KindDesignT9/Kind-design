---
import Navbareventside from '../../components/Navbareventside.astro';
import Buttonblaa from '../../components/Buttonblaa.astro';
import Singlecard from '../../components/Singlecard.astro';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
const endpoint = 'https://xrxrkbvgveqggbyflllj.supabase.co/rest/v1/Event_list?select=*';

const options = {
    headers:{apikey: 'sb_publishable_JC8KpAkpoJ3W0WeRi7EfsA_4lgf8OWs'}
}

  const response = await fetch(endpoint, options);
  const events: any[] = await response.json();

  return events.map((eventinfo) => {
    return {
      params: { id: eventinfo.id.toString() },
      props: { eventinfo },
    };
  });
}

const { id } = Astro.params;
const { eventinfo } = Astro.props;
---

<Layout title="Event">
  <div class="navbar-wrapper">
  <Navbareventside />
  </div>
  <section
    class="hero"
    style={`background-image: url('${eventinfo.img}')`}>

    <Singlecard eventinfo={eventinfo} />

    <Buttonblaa text="TICKETS" href="#" />
  </section> 
<section class="singleview_tekst">
  <h3>{eventinfo.h3_singleview}</h3>
  <p>{eventinfo.tekst_singleview}</p>

</section>

</Layout>
<style>
  p {white-space: pre-line;}
  .navbar-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
  }
  .hero {
    min-height: 55vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .singleview_tekst {
    margin: 2rem;
  }
</style>
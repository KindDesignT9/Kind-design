---
const {indexcard} = Astro.props;
---

<a class="indexcard" href={`/single-view/${indexcard.id}`}>

<div class="indexcard_indhold">
<p class="upcoming">Upcoming</p>
<h3>{indexcard.event_navn}</h3>
<p class="beskrivelse">{indexcard.short_info}</p>
</div>

<div class="buetpil">
<img src="/buet.pil.glat.svg" alt="buet pil">
</div>

</a>



<style>

    .indexcard {
    border: 1px solid #FFFFF5;
    border-radius: 20px;
    padding: 10px 20px;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
}

.indexcard h3 {
    color: #C8E8F8;
    margin-bottom: -0.5rem;
}

.indexcard .beskrivelse {
    color: white;
}

.indexcard_indhold {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
}

.buetpil {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
}

.upcoming {
    background-color: #5C5153;
    border-radius: 10px;
    color: #FEFDAE;
    padding: 5px 10px;
    margin-bottom: 0.3rem;
}

.buetpil img {
    width: 100px;
    height: auto;
}

   

</style>


---
const { title } = Astro.props;
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  body {
    background-color: #fffff5;
  }

  /* regler for fonte */
  @font-face {
    font-family: "Archivo Black";
    src: url("/ArchivoBlack-Regular1.woff2") format("woff2");
    font-weight: 900;
  }

  @font-face {
    font-family: "Inter";
    src: url("/Inter-VariabelFont.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
  }

  h1 {
    font-family: "Archivo Black";
    font-weight: 900;
    font-size: 45px;
    text-transform: uppercase;
    margin: 0;
  }

  h2 {
    font-family: "Inter";
    font-weight: 800;
    font-size: 24px;
    text-transform: uppercase;
  }

  h3 {
    font-family: "Inter";
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
  }

  p {
    font-family: "Inter";
    font-weight: 500;
    font-size: 12px;
  }

  a {
    font-family: "Inter";
  }

  /* web / desktop */
  @media (min-width: 768px) {
    h1 {
      font-size: 70px;
    }
    h2 {
      font-size: 40px;
    }
    h3 {
      font-size: 32px;
    }
    p {
      font-size: 21px;
    }
  }
</style>
